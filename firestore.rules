rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && userExists() && currentUser().role == "super_admin";
    }

    function isAdminOrStaff() {
      return isSignedIn() && userExists() && currentUser().role in ["super_admin", "madrasa_admin", "staff"];
    }

    match /madrasas/{madrasaId} {
      allow read: if isSignedIn();
      allow create, delete: if isSuperAdmin();
      allow update: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        request.auth.uid == userId ||
        userId.matches('STUDENT_.*') ||
        isAdminOrStaff()
      );
      allow delete: if isSignedIn() && (
        userId.matches('STUDENT_.*') ||
        isAdminOrStaff()
      );
    }

    match /ustads/{ustadId} {
      allow read, write: if isSignedIn();
    }

    match /forum_posts/{postId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.authorUid ||
        isAdminOrStaff()
      );

      match /comments/{commentId} {
        allow read, create: if isSignedIn();
      }
    }

    match /notices/{noticeId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /chat_rooms/{roomId} {
      allow read, write: if isSignedIn();
    }
  }
}
