rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && userExists() && currentUser().role == "super_admin";
    }

    function isAdminOrStaff() {
      return isSignedIn() && userExists() && currentUser().role in ["super_admin", "madrasa_admin", "staff"];
    }

    match /madrasas/{madrasaId} {
      allow read: if isSignedIn();
      allow create, delete: if isSuperAdmin();
      allow update: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        request.auth.uid == userId ||
        userId.matches('STUDENT_.*') ||
        isAdminOrStaff()
      );
      allow delete: if isSignedIn() && (
        userId.matches('STUDENT_.*') ||
        isAdminOrStaff()
      );
    }

    match /ustads/{ustadId} {
      allow read, write: if isSignedIn();
    }

    match /forum_posts/{postId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.authorUid ||
        isAdminOrStaff()
      );

      match /comments/{commentId} {
        allow read, create: if isSignedIn();
      }
    }

    match /notices/{noticeId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // Chat rooms carry their messages inline (bucketed pattern, latest 50).
    // lastReadAt / lastDeliveredAt per participant drive the WhatsApp-style ticks,
    // and a message is soft-deleted by its sender only.
    match /chat_rooms/{roomId} {
      allow read, write: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
    }

    // ---------------------------------------------------------------------
    // Recipient-addressed notifications (NotificationHelper).
    //  - A signed-in user may CREATE a notification for someone ELSE only
    //    (this is what makes "I message you → you get the alert" possible
    //    without a Cloud Functions backend).
    //  - Only the recipient may READ / mark-as-read / delete it.
    // ---------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != ""
        && request.resource.data.senderUid is string
        && request.resource.data.senderUid != request.resource.data.recipientUid;
      allow update, delete: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid;
    }

    match /madrasa_update_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    match /audit_logs/{logId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdminOrStaff();
    }
  }
}
